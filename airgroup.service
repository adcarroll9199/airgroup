[Unit]
Description=AirPlay to Google Cast speaker group bridge
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=airgroup
EnvironmentFile=/etc/default/airgroup
# Create the FIFO before we count as started, so shairport-sync (ordered After=us) always finds it.
ExecStartPre=-/usr/bin/mkfifo -m 0666 /run/airgroup/audio.fifo
ExecStart=/opt/airgroup/venv/bin/python /opt/airgroup/airgroup.py
RuntimeDirectory=airgroup
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
Nice=-5
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
