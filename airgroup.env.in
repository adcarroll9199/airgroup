# airgroup settings. After editing: sudo systemctl restart airgroup

# Speaker group name exactly as shown in the Google Home app.
# List what the Pi can see with:  /opt/airgroup/venv/bin/python /opt/airgroup/airgroup.py --list
CAST_TARGET="@CAST_TARGET@"

HTTP_PORT=@HTTP_PORT@
MP3_BITRATE=320k
STREAM_TITLE="AirPlay"

# Forward the iPhone volume slider to the speaker group (1/0), and cap it (0.0-1.0).
SYNC_VOLUME=1
MAX_VOLUME=1.0

# Seconds to keep the group after the phone disconnects, so track changes don't drop it.
STOP_GRACE_SEC=30
# Release the speakers if the phone stays paused this long (seconds).
SILENCE_TIMEOUT_SEC=600

# Set if auto-detection picks the wrong address for the speakers to reach the Pi.
ADVERTISE_HOST=
LOG_LEVEL=INFO
